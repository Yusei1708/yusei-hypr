#!/usr/bin/env bash
SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")/.." && pwd)"
if [[ -x "$SCRIPT_DIR/scripts/power-optimizer.sh" ]]; then
    exec "$SCRIPT_DIR/scripts/power-optimizer.sh" "$@"
elif [[ -x "$HOME/.local/share/yusei-hypr/scripts/power-optimizer.sh" ]]; then
    exec "$HOME/.local/share/yusei-hypr/scripts/power-optimizer.sh" "$@"
elif [[ -x "$HOME/.config/hypr/scripts/power-optimizer.sh" ]]; then
    exec "$HOME/.config/hypr/scripts/power-optimizer.sh" "$@"
fi
echo "Error: power-optimizer.sh not found" >&2
exit 1
