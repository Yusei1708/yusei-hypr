#!/usr/bin/env bash
# ==============================================================================
# yusei-settings: Launcher Executable
# ==============================================================================

set -euo pipefail

SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")/.." && pwd)"
PYTHON_BIN="$(command -v python3 || echo "python")"

if [[ -f "$SCRIPT_DIR/yusei_settings/cli.py" ]]; then
    exec "$PYTHON_BIN" "$SCRIPT_DIR/yusei_settings/cli.py" "$@"
elif [[ -f "$HOME/.local/share/yusei-hypr/yusei_settings/cli.py" ]]; then
    exec "$PYTHON_BIN" "$HOME/.local/share/yusei-hypr/yusei_settings/cli.py" "$@"
fi

echo "Error: yusei_settings/cli.py not found" >&2
exit 1
