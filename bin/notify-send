#!/usr/bin/env bash
# ==============================================================================
# yusei-hypr: Unified 3-Second Single-Slot notify-send Wrapper
# Enforces a 3000ms (3s) popup timeout and a shared synchronous tag on default
# transient notifications, while passing interactive (-A/--action), critical
# (-u critical), persistent (-t 0 / -t >= 5000), and caller-tagged
# (x-canonical-private-synchronous:*) notifications through untouched.
# ==============================================================================

REAL_NOTIFY_SEND="${REAL_NOTIFY_SEND:-/usr/bin/notify-send}"
if [[ ! -x "$REAL_NOTIFY_SEND" ]]; then
    # Fallback search excluding ~/.local/bin
    REAL_NOTIFY_SEND=$(PATH="/usr/local/bin:/usr/bin:/bin" command -v notify-send || true)
fi

if [[ -z "$REAL_NOTIFY_SEND" || ! -x "$REAL_NOTIFY_SEND" ]]; then
    exit 0
fi

# Pass through bare -h untouched
if [[ $# -eq 1 && "$1" == "-h" ]]; then
    exec "$REAL_NOTIFY_SEND" "$@"
fi

resolve_icon_arg() {
    local val="$1"
    local expanded="${val/#\~/$HOME}"

    # Leave icon theme names untouched (no slash)
    if [[ -z "$expanded" || "$expanded" != */* ]]; then
        printf '%s' "$val"
        return 0
    fi

    # Keep existing filesystem icon paths untouched
    if [[ -e "$expanded" ]]; then
        printf '%s' "$val"
        return 0
    fi

    local base="${expanded##*/}"
    local xdg_cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
    if [[ -e "$xdg_cfg/swaync/icons/$base" ]]; then
        printf '%s' "$xdg_cfg/swaync/icons/$base"
        return 0
    fi
    if [[ -e "$HOME/.config/swaync/icons/$base" ]]; then
        printf '%s' "$HOME/.config/swaync/icons/$base"
        return 0
    fi

    case "${base,,}" in
        error*) printf '%s' "dialog-error" ;;
        warn*) printf '%s' "dialog-warning" ;;
        bell*|ja.png|note*|info*) printf '%s' "dialog-information" ;;
        music*) printf '%s' "audio-x-generic" ;;
        picture*) printf '%s' "image-x-generic" ;;
        palette*|dropper*) printf '%s' "applications-graphics" ;;
        timer*) printf '%s' "alarm-symbolic" ;;
        volume*) printf '%s' "audio-volume-medium" ;;
        mic*|microphone*) printf '%s' "audio-input-microphone" ;;
        brightness*) printf '%s' "display-brightness-symbolic" ;;
        *) printf '%s' "dialog-information" ;;
    esac
}

orig_args=("$@")
resolved_orig_args=()
new_args=()
timeout_val=3000
passthrough=false
has_action=false
stop_opts=false

while [[ $# -gt 0 ]]; do
    if [[ "$stop_opts" == "true" ]]; then
        resolved_orig_args+=("$1")
        new_args+=("$1")
        shift
        continue
    fi

    case "$1" in
        --)
            stop_opts=true
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        -\?|--help|-v|--version)
            exec "$REAL_NOTIFY_SEND" "${orig_args[@]}"
            ;;
        -A|--action)
            has_action=true
            passthrough=true
            if [[ $# -ge 2 ]]; then
                resolved_orig_args+=("$1" "$2")
                shift 2
            else
                resolved_orig_args+=("$1")
                shift
            fi
            ;;
        -A*|--action=*)
            has_action=true
            passthrough=true
            resolved_orig_args+=("$1")
            shift
            ;;
        -u|--urgency)
            if [[ $# -ge 2 ]]; then
                if [[ "${2,,}" == "critical" ]]; then
                    passthrough=true
                fi
                resolved_orig_args+=("$1" "$2")
                new_args+=("$1" "$2")
                shift 2
                continue
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        --urgency=*)
            val="${1#*=}"
            if [[ "${val,,}" == "critical" ]]; then
                passthrough=true
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        -u?*)
            val="${1#-u}"
            if [[ "${val,,}" == "critical" ]]; then
                passthrough=true
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        -t|--expire-time)
            if [[ $# -ge 2 ]]; then
                resolved_orig_args+=("$1" "$2")
                val="$2"
                if [[ "$val" =~ ^[0-9]+$ ]]; then
                    if (( 10#$val == 0 || 10#$val >= 5000 )); then
                        passthrough=true
                    elif (( 10#$val > 0 && 10#$val < 3000 )); then
                        timeout_val=$((10#$val))
                    fi
                else
                    new_args+=("$1" "$2")
                fi
                shift 2
                continue
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        --expire-time=*)
            resolved_orig_args+=("$1")
            val="${1#*=}"
            if [[ "$val" =~ ^[0-9]+$ ]]; then
                if (( 10#$val == 0 || 10#$val >= 5000 )); then
                    passthrough=true
                elif (( 10#$val > 0 && 10#$val < 3000 )); then
                    timeout_val=$((10#$val))
                fi
            else
                new_args+=("$1")
            fi
            shift
            ;;
        -t?*)
            resolved_orig_args+=("$1")
            val="${1#-t}"
            if [[ "$val" =~ ^[0-9]+$ ]]; then
                if (( 10#$val == 0 || 10#$val >= 5000 )); then
                    passthrough=true
                elif (( 10#$val > 0 && 10#$val < 3000 )); then
                    timeout_val=$((10#$val))
                fi
            else
                new_args+=("$1")
            fi
            shift
            ;;
        -h|--hint)
            if [[ $# -ge 2 ]]; then
                hint_val="$2"
                if [[ "$hint_val" == *x-canonical-private-synchronous:* ]]; then
                    passthrough=true
                fi
                resolved_orig_args+=("$1" "$2")
                new_args+=("$1" "$2")
                shift 2
                continue
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        --hint=*)
            hint_val="${1#*=}"
            if [[ "$hint_val" == *x-canonical-private-synchronous:* ]]; then
                passthrough=true
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        -h?*)
            hint_val="${1#-h}"
            if [[ "$hint_val" == *x-canonical-private-synchronous:* ]]; then
                passthrough=true
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        -i|--icon)
            if [[ $# -ge 2 ]]; then
                resolved_icon="$(resolve_icon_arg "$2")"
                resolved_orig_args+=("$1" "$resolved_icon")
                new_args+=("$1" "$resolved_icon")
                shift 2
                continue
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        --icon=*)
            resolved_icon="$(resolve_icon_arg "${1#--icon=}")"
            resolved_orig_args+=("--icon=$resolved_icon")
            new_args+=("--icon=$resolved_icon")
            shift
            ;;
        -i?*)
            resolved_icon="$(resolve_icon_arg "${1#-i}")"
            resolved_orig_args+=("-i$resolved_icon")
            new_args+=("-i$resolved_icon")
            shift
            ;;
        -a|--app-name|-n|--app-icon|-c|--category|-r|--replace-id|--id-fd|--selected-action-fd|--activation-token-fd)
            if [[ $# -ge 2 ]]; then
                resolved_orig_args+=("$1" "$2")
                new_args+=("$1" "$2")
                shift 2
                continue
            fi
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
        *)
            resolved_orig_args+=("$1")
            new_args+=("$1")
            shift
            ;;
    esac
done

if [[ "$has_action" == "true" ]]; then
    ACTION_MARKER="${XDG_RUNTIME_DIR:-/tmp}/.yusei_swaync_action_pending"
    date +%s > "$ACTION_MARKER" 2>/dev/null || true
fi

if [[ "$passthrough" == "true" ]]; then
    exec "$REAL_NOTIFY_SEND" "${resolved_orig_args[@]}"
fi

exec "$REAL_NOTIFY_SEND" \
    -t "$timeout_val" \
    -h "string:x-canonical-private-synchronous:yusei-popup" \
    "${new_args[@]}"
